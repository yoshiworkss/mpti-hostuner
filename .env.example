# ==============================================================================
# Hostuner-25 Frontend Environment Variables (Vite + React + TypeScript)
# Copy this file to `.env.local` for local development, or configure in Vercel
# Project Settings -> Environment Variables.
# ==============================================================================

# Base URL for Muhammad Hanif's Node.js REST API (leave empty for local demo mode)
# Example: http://localhost:3000/api  or  https://api.hostuner.com/api
VITE_API_BASE_URL=

# Cloudflare Turnstile public Site Key (FR-08 Anti-Bot Verification)
# Obtain from Cloudflare Dashboard -> Turnstile -> Site Key
VITE_TURNSTILE_SITE_KEY=

# Optional official Static QRIS image URL or public path (e.g. /qris-hostuner.png)
# When empty, Invoice 19B displays a clean official Hostuner QRIS placeholder frame.
VITE_HOSTUNER_QRIS_IMAGE_URL=
